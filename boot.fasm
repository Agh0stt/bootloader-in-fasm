# boot.fasm — 16-bit real-mode boot sector, hand-encoded
# faSM's `instr_size()` only sizes IT_INSTR items in section text (db/times
# are zero-sized there); raw data bytes must live in `section data`, which is
# emitted immediately after (empty) .text -- so it lands exactly at the ELF
# entry point (text_base + 0). We objcopy/dd this back out to a flat image.
section data
    db 0x31, 0xc0, 0x8e, 0xd8, 0x8e, 0xc0, 0x8e, 0xd0, 0xbc, 0x00, 0x7c, 0xbe
    db 0x1f, 0x7c, 0xac, 0x08, 0xc0, 0x74, 0x08, 0xb4, 0x0e, 0xb7, 0x00, 0xcd
    db 0x10, 0xeb, 0xf3, 0xfa, 0xf4, 0xeb, 0xfc, 0x48, 0x65, 0x6c, 0x6c, 0x6f
    db 0x20, 0x66, 0x72, 0x6f, 0x6d, 0x20, 0x61, 0x20, 0x77, 0x6f, 0x72, 0x6b
    db 0x69, 0x6e, 0x67, 0x20, 0x62, 0x6f, 0x6f, 0x74, 0x6c, 0x6f, 0x61, 0x64
    db 0x65, 0x72, 0x21, 0x0d, 0x0a, 0x00
    times 444 db 0
    db 0x55, 0xaa
